<main class="notes-app">
  <section class="notes-content">
    <% if authenticated? %>
    <% if flash[:notice] || flash[:alert] %>
      <div class="notes-message <%= flash[:alert] ? "notes-message-error" : "notes-message-success" %>">
        <%= flash[:alert] || flash[:notice] %>
      </div>
    <% end %>
    <div class="page-heading">
        <div>
            <p class="eyebrow">Рабочая область</p>
            <h1><%= @workspace&.name || "Мои заметки" %></h1>
            <p class="muted-text">Соберите мысли, задачи и идеи в одном месте.</p>
        </div>
        <%= link_to "+ Новая заметка",
            @workspace ? new_note_path(workspace_id: @workspace.id) : new_session_path,
            class: "button button-primary" %>
    </div>
    <div class="notes-toolbar">
      <form class="search-form" action="#" method="get">
        <label class="sr-only" for="notes-index-search">Поиск по заметкам</label>
        <input id="notes-index-search" type="search" placeholder="Поиск по заметкам...">
        <button type="submit" class="search-button">Найти</button>
      </form>
      <%= form_tag notes_path(workspace_id: @workspace&.id), method: :get do %>
        <%= select_tag :category_id,
          options_for_select(
            [["Все категории", ""], ["Без категории", "none"]] +
            Category.order(:name).map { |category| [category.name, category.id] },
            params[:category_id]
          ),
          class: "filter-select",
          aria: { label: "Фильтр по категории" },
          onchange: "this.form.submit()" %>
        <%= select_tag :sort,
          options_for_select(
            [
              ["Сначала новые", "newest"],
              ["Сначала старые", "oldest"],
              ["По названию", "title"]
            ],
            params[:sort].presence || "newest"
          ),
          class: "filter-select",
          aria: { label: "Сортировка" },
          onchange: "this.form.submit()" %>
      <% end %>
    </div>
    <section class="workspace-members">
      <div>
        <p class="eyebrow">Участники</p>
        <p class="muted-text">
          Владелец: @<%= @workspace.user.username %>
        </p>
      </div>

      <div class="workspace-member-list">
        <% @workspace.members.each do |member| %>
          <span class="tag">
            @<%= member.username %>
            <% if @workspace.user_id == Current.user.id && member.id != @workspace.user_id %>
              <%= button_to "×",
                    workspace_member_path(@workspace, member),
                    method: :delete,
                    class: "member-remove",
                    aria: { label: "Удалить @#{member.username}" } %>
            <% end %>
          </span>
        <% end %>
      </div>

      <% if @workspace.user_id == Current.user.id %>
        <%= form_tag workspace_members_path(@workspace), method: :post, class: "member-form" do %>
          <%= text_field_tag :username, nil,
                placeholder: "Введите username пользователя",
                required: true %>
          <%= submit_tag "Добавить пользователя", class: "button button-outline" %>
        <% end %>
      <% end %>
    </section>
    <% if @notes.any? %>
      <div class="notes-grid">
        <% @notes.each do |note| %>
          <article class="note-card">
            <div class="note-card-topline">
              <span class="category-badge category-study">
                <%= note.category&.name || "Без категории" %>
              </span>
              <button type="button" class="icon-button" aria-label="Меню заметки">•••</button>
            </div>
            <%= link_to note.title, note_path(note), class: "note-title" %>
            <p class="note-excerpt"><%= note.body %></p>
            <div class="note-card-footer">
              <%= link_to "Открыть →", note_path(note), class: "note-link" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">✦</div>
        <h2>Пока нет заметок</h2>
        <p>Создайте первую заметку, чтобы сохранить важную мысль.</p>
        <%= link_to "Создать заметку",
            @workspace ? new_note_path(workspace_id: @workspace.id) : new_session_path,
            class: "button button-primary" %>
      </div>
    <% end %>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">✦</div>
        <h1>Войдите, чтобы начать</h1>
        <p>Создавайте рабочие области и сохраняйте в них свои заметки.</p>
        <div class="form-actions">
          <%= link_to "Войти", new_session_path, class: "button button-primary" %>
          <%= link_to "Зарегистрироваться", new_registration_path, class: "button button-outline" %>
        </div>
      </div>
    <% end %>
  </section>
</main>