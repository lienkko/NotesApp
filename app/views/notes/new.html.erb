<% content_for :head do %>
<%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
<% end %>

<main class="notes-app">
  <%= render "notes_header" %>
  <section class="editor-content">
    <p class="eyebrow">Новая запись</p>
    <h1>Создать заметку</h1>
    <%= form_with model: @note, class: "note-form" do |form| %>
    <div class="form-field">
      <%= form.label :title, "Заголовок" %>
      <%= form.text_field :title, id: "new-note-title", placeholder:
      "Например, идеи для проекта", required: true %>
    </div>
    <div class="form-field">
      <%= form.label :body, "Текст заметки" %>
      <%= form.text_field :body, id: "new-note-body", rows: 10, placeholder:
      "Запишите всё, что не хотите забыть..." %>
    </div>
    <div class="form-row">
      <div class="form-field">
        <%= form.label :category, "Категория" %>
        <%= form.collection_select :category_id, Category.order(:name), :id,
        :name,
        include_blank: "Без категории" %>
      </div>
      <div class="form-field">
        <%= form.label :tag_names, "Теги" %>
        <%= form.text_field :tag_names,
        placeholder: "Например: ruby, rails, программирование" %>
        <small>Разделяйте теги запятыми</small>
      </div>
    </div>
    <div class="form-actions">
      <%= link_to "Отмена", notes_path, class: "button button-outline" %>
      <%= form.submit "Сохранить заметку", class: "button button-primary" %>
    </div>
    <% end %>
  </section>
</main>
