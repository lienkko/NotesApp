<% content_for :head do %>
  <%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
<% end %>

<main class="notes-app" data-controller="delete-dialog">
  <%= render "notes_header" %>
  <article class="note-view">
    <div class="note-view-header">
      <span class="category-badge category-study"><%= @note.category&.name || "Без категории" %></span>
      <div class="note-view-actions">
        <%= link_to "Редактировать", "#", class: "button button-outline button-small" %>
        <button type="button" class="danger-button" data-action="delete-dialog#open">
          Удалить
        </button>
      </div>
    </div>
    <h1><%= @note.title %></h1>
    <div class="note-meta">Создано 12 мая 2025 · Изменено сегодня</div>
    <div class="note-body"><%= @note.body %></div>
    <div class="tag-list">
      <% @note.tags.each do |tag| %>
        <span class="tag"><%= tag.name %></span>
      <% end %>
    </div>
  </article>
  <div class="delete-dialog-demo" role="dialog" aria-labelledby="delete-title"
       data-delete-dialog-target="dialog" hidden>
    <h2 id="delete-title">Удалить заметку?</h2>
    <p>Это действие нельзя отменить. Заметка будет удалена навсегда.</p>
    <div class="form-actions">
      <button type="button" class="button button-outline" data-action="delete-dialog#close">
        Отмена
      </button>
      <button type="button" class="button button-danger">Удалить</button>
    </div>
  </div>
</main>
