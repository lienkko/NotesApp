<% content_for :head do %>
  <%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
<% end %>

<header class="notes-header">
  <%= link_to "Notes App", root_path, class: "brand" %>
  <%= link_to "Пользователи", admin_users_path, class: "button button-outline button-small" %>
  <%= link_to "Рабочие области", workspaces_path, class: "button button-outline button-small" %>
</header>

<main class="notes-app">
  <section class="notes-content">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Администрирование</p>
        <h1>Рабочие области @<%= @user.username %></h1>
        <p class="muted-text"><%= @user.email_address %></p>
      </div>
    </div>

    <% if @workspaces.any? %>
      <div class="notes-grid">
        <% @workspaces.each do |workspace| %>
          <article class="note-card">
            <h2 class="note-title"><%= workspace.name %></h2>
            <p class="note-excerpt">
              Владелец: @<%= workspace.user.username %><br>
              Заметок: <%= workspace.notes.size %><br>
              Участников: <%= workspace.members.count { |member| member.id != workspace.user_id } %>
            </p>
            <% members = workspace.members.reject { |member| member.id == workspace.user_id } %>
            <% if members.any? %>
              <p class="muted-text">
                Участники:
                <%= members.map { |member| "@#{member.username}" }.join(", ") %>
              </p>
            <% end %>
            <%= form_with url: admin_workspace_members_path(workspace), method: :post do |form| %>
              <%= form.text_field :username, required: true, placeholder: "username участника" %>
              <%= form.submit "Добавить", class: "button button-primary" %>
            <% end %>
            <% members.each do |member| %>
              <%= button_to "Удалить @#{member.username}",
                    admin_workspace_member_path(workspace, member),
                    method: :delete,
                    class: "button button-outline",
                    form: { data: { turbo_confirm: "Удалить участника из рабочей области?" } } %>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h2>Рабочих областей пока нет</h2>
        <p>У этого пользователя нет собственных или общих рабочих областей.</p>
      </div>
    <% end %>
  </section>
</main>
