<% content_for :head do %>
<%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
<% end %>

<header class="notes-header">
  <%= link_to "Notes App", root_path, class: "brand" %>
  <div class="notes-header-actions">
    <% if authenticated? %>
    <%= link_to "Профиль", profile_path, class:
    "button button-primary button-small" %>
    <%= button_to "Выйти", session_path, method: :delete, class:
    "button button-outline button-small" %>
    <% else %>
    <%= link_to "Войти", new_session_path, class:
    "button button-primary button-small" %>
    <%= link_to "Регистрация", new_registration_path, class:
    "button button-outline button-small" %>
    <% end %>
  </div>
</header>
<%= render "notes/notes_main"%>