<% content_for :head do %>
  <%= stylesheet_link_tag "profiles", "data-turbo-track": "reload" %>
<% end %>

<main class="profile-page">
  <section class="profile-card">
    <%= link_to "Notes App", root_path, class: "profile-brand" %>
    <p class="profile-eyebrow">Личный кабинет</p>
    <h1>Изменить профиль</h1>

    <% if @user.errors.any? %>
      <div class="auth-message auth-message-error">
        <% @user.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "auth-form" do |form| %>
      <div class="form-field">
        <%= form.label :username, "Имя пользователя" %>
        <%= form.text_field :username,
              required: true,
              autocomplete: "username",
              placeholder: "например, alex_ivanov" %>
        <small>От 3 до 30 символов: латинские буквы, цифры и _</small>
      </div>

      <%= form.submit "Сохранить", class: "button button-primary auth-submit" %>
    <% end %>

    <%= link_to "Отмена", profile_path, class: "auth-link" %>
  </section>
</main>
