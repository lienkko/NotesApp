<% content_for :head do %>
  <%= stylesheet_link_tag "profiles", "data-turbo-track": "reload" %>
<% end %>

<main class="profile-page">
  <section class="profile-card">
    <%= link_to "Notes App", root_path, class: "profile-brand" %>
    <p class="profile-eyebrow">Личный кабинет</p>
    <h1>Смена пароля</h1>
    <p class="profile-description">
      Введите текущий пароль и придумайте новый.
    </p>

    <% if @user.errors.any? %>
      <div class="profile-message profile-message-error">
        <% @user.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with url: update_profile_password_path,
                  method: :patch,
                  class: "profile-form" do |form| %>
      <div class="form-field">
        <%= form.label :current_password, "Текущий пароль" %>
        <%= form.password_field :current_password,
              required: true,
              autocomplete: "current-password" %>
      </div>

      <div class="form-field">
        <%= form.label :password, "Новый пароль" %>
        <%= form.password_field :password,
              required: true,
              autocomplete: "new-password",
              maxlength: 72 %>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation, "Повторите новый пароль" %>
        <%= form.password_field :password_confirmation,
              required: true,
              autocomplete: "new-password",
              maxlength: 72 %>
      </div>

      <%= form.submit "Сохранить новый пароль",
            class: "button button-primary profile-submit" %>
    <% end %>

    <%= link_to "Вернуться в профиль", profile_path, class: "profile-home-link" %>
  </section>
</main>