<h1>Смена пароля</h1>

<%= form_with url: update_profile_password_path, method: :patch do |form| %>
  <div>
    <%= form.label :current_password, "Текущий пароль" %>
    <%= form.password_field :current_password %>
  </div>

  <div>
    <%= form.label :password, "Новый пароль" %>
    <%= form.password_field :password,
          required: true,
          autocomplete: "new-password",
          maxlength: 72 %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Повторите пароль" %>
    <%= form.password_field :password_confirmation,
          required: true,
          autocomplete: "new-password",
          maxlength: 72 %>
  </div>

  <%= form.submit "Сохранить новый пароль" %>
<% end %>

<%= link_to "Вернуться в профиль", profile_path %>