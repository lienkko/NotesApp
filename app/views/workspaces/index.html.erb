<% content_for :head do %>
  <%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
<% end %>

  <header class="notes-header">
    <%= link_to "Notes App", root_path, class: "brand" %>
    <% if Current.user.admin? %>
      <%= link_to "Пользователи", admin_users_path, class: "button button-outline button-small" %>
    <% end %>
    <%= link_to "Профиль", profile_path, class: "button button-outline button-small" %>
  </header>
<main class="notes-app">
<% @workspaces.each do |workspace| %>
  <%= turbo_stream_from "workspace_#{workspace.id}" %>
<% end %>
  <section class="notes-content">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Личное пространство</p>
        <h1>Рабочие области</h1>
        <p class="muted-text">Разделите заметки по проектам, учёбе или другим темам.</p>
      </div>
      <%= link_to "+ Новая область", new_workspace_path, class: "button button-primary" %>
    </div>

    <% if @workspaces.any? %>
      <div class="notes-grid">
        <% @workspaces.each do |workspace| %>
          <article class="note-card">
            <div class="workspace-card-header">
              <h2 class="note-title"><%= workspace.name %></h2>
              <% if workspace.user_id != Current.user.id %>
                <p class="workspace-owner">
                  @<%= workspace.user.username %>
                </p>
              <% end %>
            </div>
            <p class="note-excerpt">
              <%= pluralize(workspace.notes.count, "заметка", "заметок") %>
            </p>
            <div class="workspace-card-footer">
              <%= link_to "Открыть →", workspace_path(workspace), class: "note-link" %>
              <% if workspace.user_id != Current.user.id %>
                <%= button_to "Выйти",
                      leave_workspace_path(workspace),
                      method: :delete,
                      class: "workspace-leave",
                      form: { data: { turbo_confirm: "Выйти из этой рабочей области?" } } %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">✦</div>
        <h2>Пока нет рабочих областей</h2>
        <p>Создайте первую область, чтобы начать добавлять заметки.</p>
        <%= link_to "Создать рабочую область", new_workspace_path, class: "button button-primary" %>
      </div>
    <% end %>
  </section>
</main>
