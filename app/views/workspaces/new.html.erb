<% content_for :head do %>
  <%= stylesheet_link_tag "notes", "data-turbo-track": "reload" %>
<% end %>

<main class="notes-app">
  <section class="editor-content">
    <p class="eyebrow">Новая область</p>
    <h1>Создать рабочую область</h1>

    <%= form_with model: @workspace, class: "note-form" do |form| %>
      <div class="form-field">
        <%= form.label :name, "Название" %>
        <%= form.text_field :name, placeholder: "Например, Учёба или Работа", required: true %>
      </div>
      <div class="form-actions">
        <%= link_to "Отмена", workspaces_path, class: "button button-outline" %>
        <%= form.submit "Создать область", class: "button button-primary" %>
      </div>
    <% end %>
  </section>
</main>
